# Copy to .env on your own machine. Never commit credentials.
# In Codex cloud, use secure environment settings instead.
OPENAI_API_KEY=
# Optional alternative: explicitly select an ElevenLabs voice in the editor.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional runtime paths (defaults are .runtime/ and .runtime/models/).
# RANK_DATA_DIR=/workspace/youtube-shorts/.runtime
# PIPER_MODEL_DIR=/workspace/youtube-shorts/.runtime/models
OPENAI_TEXT_MODEL=gpt-4o-mini
# Public hosting uses browser Basic Auth; set these directly in Render's secret settings.
# STUDIO_PUBLIC=1
# STUDIO_USERNAME=owner
# STUDIO_PASSWORD=
