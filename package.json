  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.58.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
